# Recreate environments from requirements.txt instead of committing them.
# Python environments
.venv/
venv/

# Python-generated files
__pycache__/
*.py[cod]

# Editor settings
.idea/
.vscode/

# Local credentials and configuration
.env
.env.*
!.env.example

# Operating-system files
.DS_Store
Thumbs.db

# Local caches and backups
